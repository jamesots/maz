{
  "name": "maz",
  "version": "0.6.0",
  "description": "Macro Assembler for Z80",
  "main": "lib/maz.js",
  "bin": {
    "maz": "lib/maz.js"
  },
  "repository": "jamesots/maz",
  "types": "lib/maz.d.ts",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build-parser": "peggy -o src/parser.js src/parser.pegjs && mkdir -p lib && cp src/parser.js src/parser.d.ts lib/",
    "build-expr": "peggy -o src/expr.js src/expr.pegjs && mkdir -p lib && cp src/expr.js src/expr.d.ts lib/",
    "trace-parser": "peggy --trace -o src/parser.js src/parser.pegjs && cp src/parser.js lib/",
    "trace-expr": "peggy --trace -o src/expr.js src/expr.pegjs && cp src/expr.js lib/",
    "build-tsc": "tsc",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "build": "npm run build-tsc && npm run build-parser && npm run build-expr",
    "prepublish": "npm run build",
    "test": "npm run build && tsc -p test && vitest run",
    "coverage": "npm run build && vitest run --coverage",
    "start": "node lib/maz.js",
    "test-z80": "node lib/maz.js -s examples/z80monitor.z80 -o /tmp/z80monitor.bin -l /tmp/z80monitor.lst",
    "test-incbin": "node lib/maz.js -s examples/incbin.z80 -o /tmp/incbin.bin -l /tmp/incbin.lst",
    "test-broke2": "node lib/maz.js -u -s examples/broke2.z80 -o /tmp/broke2.bin -l /tmp/broke2.lst",
    "test-all": "node lib/maz.js -u -s examples/all.z80 -o /tmp/all.bin -l /tmp/all.lst",
    "test-search": "node lib/maz.js -u -s examples/search.z80 -o /tmp/search.bin -l /tmp/search.lst -p examples/another_dir -p examples/search_dir_2"
  },
  "author": "James Ots <code@jamesots.com>",
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/command-line-args": "5.2.3",
    "@types/command-line-usage": "^5.0.4",
    "@types/node": "^26.6.2",
    "@types/source-map-support": "^0.5.10",
    "@vitest/coverage-v8": "^5.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "peggy": "^5.1.0",
    "pegjs-backtrace": "^0.2.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "command-line-args": "^6.0.2",
    "command-line-usage": "^7.0.4",
    "source-map-support": "^0.5.21"
  }
}
